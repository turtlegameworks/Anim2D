{
  "schema_version": 1,
  "id": "magic_circle",
  "version": 1,
  "name": "Magic Circle",
  "category": "magic",
  "description": "A rune circle grows on the ground, turns with a counter-turning inner circle, then fades.",
  "tags": [
    "magic",
    "circle",
    "rune",
    "summon",
    "spell",
    "cast"
  ],
  "generator": "spin_glow",
  "generator_version": 1,
  "source_duration_seconds": 1.5,
  "supports_loop": false,
  "required_features": [
    "bones",
    "regions",
    "slot_color",
    "attachment_keys",
    "bezier_curves"
  ],
  "preview": null,
  "images": {
    "rune": "images/rune.png",
    "glow": "images/glow.png"
  },
  "common_overrides": {
    "duration": {
      "default": 1.5,
      "min": 0.1,
      "max": 4.0
    },
    "primary_color": {
      "default": "9c7bffff"
    },
    "secondary_color": {
      "default": "d9c8ffff"
    }
  },
  "parameters": {
    "circle_size": {
      "type": "number",
      "default": 300,
      "min": 60,
      "max": 900,
      "label": "Circle size",
      "unit": "px"
    },
    "spin": {
      "type": "number",
      "default": 180,
      "min": -720,
      "max": 720,
      "label": "Spin",
      "unit": "\u00b0",
      "description": "Total turn; negative turns clockwise"
    },
    "squash": {
      "type": "number",
      "default": 0.45,
      "min": 0.1,
      "max": 1.0,
      "label": "Squash",
      "description": "1 = facing the camera; lower lies on the ground"
    },
    "glow_size": {
      "type": "number",
      "default": 320,
      "min": 0,
      "max": 900,
      "label": "Glow size",
      "unit": "px",
      "description": "0 removes the glow"
    },
    "hold": {
      "type": "number",
      "default": 0.75,
      "min": 0.3,
      "max": 0.95,
      "label": "Fade start",
      "description": "When the fade-out begins",
      "group": "advanced"
    }
  }
}
