{
  "schema_version": 1,
  "id": "level_up",
  "version": 1,
  "name": "Level Up",
  "category": "reward",
  "description": "A pillar of light shoots up, a ring spreads at its base and sparkles rise.",
  "tags": [
    "level up",
    "levelup",
    "pillar",
    "beam",
    "power up",
    "reward"
  ],
  "generator": "pillar_burst",
  "generator_version": 1,
  "source_duration_seconds": 1.2,
  "supports_loop": false,
  "required_features": [
    "bones",
    "regions",
    "slot_color",
    "attachment_keys",
    "bezier_curves"
  ],
  "preview": null,
  "images": {
    "beam": "images/beam.png",
    "ring": "images/ring.png",
    "sparkle": "images/sparkle.png"
  },
  "common_overrides": {
    "duration": {
      "default": 1.2,
      "min": 0.1,
      "max": 4.0
    },
    "primary_color": {
      "default": "fff1a0ff"
    },
    "secondary_color": {
      "default": "ffd24aff"
    }
  },
  "parameters": {
    "pillar_height": {
      "type": "number",
      "default": 420,
      "min": 80,
      "max": 1200,
      "label": "Pillar height",
      "unit": "px"
    },
    "pillar_width": {
      "type": "number",
      "default": 110,
      "min": 20,
      "max": 400,
      "label": "Pillar width",
      "unit": "px"
    },
    "sparkles": {
      "type": "integer",
      "default": 12,
      "min": 0,
      "max": 40,
      "label": "Sparkles"
    }
  }
}
