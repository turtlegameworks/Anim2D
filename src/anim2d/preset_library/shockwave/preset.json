{
  "schema_version": 1,
  "id": "shockwave",
  "version": 1,
  "name": "Shockwave",
  "category": "combat",
  "description": "Rings expand from the centre after a quick glow: landings, stomps, ground slams.",
  "tags": [
    "shockwave",
    "ring",
    "stomp",
    "slam",
    "landing",
    "wave"
  ],
  "generator": "ring_wave",
  "generator_version": 1,
  "source_duration_seconds": 0.6,
  "supports_loop": false,
  "required_features": [
    "bones",
    "regions",
    "slot_color",
    "attachment_keys",
    "bezier_curves"
  ],
  "preview": null,
  "images": {
    "ring": "images/ring.png",
    "glow": "images/glow.png"
  },
  "common_overrides": {
    "duration": {
      "default": 0.6,
      "min": 0.1,
      "max": 4.0
    },
    "primary_color": {
      "default": "bfe8ffff"
    },
    "secondary_color": {
      "default": "ffffffff"
    }
  },
  "parameters": {
    "rings": {
      "type": "integer",
      "default": 2,
      "min": 1,
      "max": 5,
      "label": "Rings"
    },
    "start_size": {
      "type": "number",
      "default": 40,
      "min": 0,
      "max": 400,
      "label": "Start size",
      "unit": "px"
    },
    "end_size": {
      "type": "number",
      "default": 360,
      "min": 50,
      "max": 1200,
      "label": "End size",
      "unit": "px"
    },
    "squash": {
      "type": "number",
      "default": 0.4,
      "min": 0.1,
      "max": 1.0,
      "label": "Squash",
      "description": "1 = round; lower looks flat on the ground"
    },
    "glow_size": {
      "type": "number",
      "default": 200,
      "min": 0,
      "max": 600,
      "label": "Glow size",
      "unit": "px",
      "description": "0 removes the glow"
    },
    "ring_gap": {
      "type": "number",
      "default": 0.15,
      "min": 0.0,
      "max": 0.5,
      "label": "Ring gap",
      "description": "Delay between rings, fraction of duration",
      "group": "advanced"
    }
  }
}
