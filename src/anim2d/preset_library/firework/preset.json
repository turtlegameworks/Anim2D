  "preview": null,
  "images": {
    "streak": "images/streak.png",
    "spark": "images/spark.png",
    "glow": "images/glow.png"
  },
  "common_overrides": {
    "duration": {
      "default": 1.6,
      "min": 0.1,
      "max": 5.0
    },
    "primary_color": {
      "default": "ff5fa8ff"
    },
    "secondary_color": {
      "default": "ffe27aff"
    }
  },
  "parameters": {
