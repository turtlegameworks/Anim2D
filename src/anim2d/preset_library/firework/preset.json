      "type": "number",
      "default": 300,
      "min": 0,
      "max": 1200,
      "label": "Burst height",
      "unit": "px"
    },
    "launch_portion": {
      "type": "number",
      "default": 0.3,
      "min": 0.0,
      "max": 0.6,
      "label": "Launch time",
      "description": "0 bursts at once without a rocket"
    },
    "sparks": {
      "type": "integer",
      "default": 24,
      "min": 4,
      "max": 60,
      "label": "Sparks"
    },
    "burst_radius": {
      "type": "number",
      "default": 170,
      "min": 30,
      "max": 600,
      "label": "Burst radius",
      "unit": "px"
    }
