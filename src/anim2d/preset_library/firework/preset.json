{
  "schema_version": 1,
  "id": "firework",
  "version": 1,
  "name": "Firework",
  "category": "casual",
  "description": "A rocket streaks up and bursts into a ring of sparks that droop and fade: celebrations.",
  "tags": [
    "firework",
    "celebration",
    "party",
    "burst",
    "win",
    "new year",
    "casual"
  ],
  "generator": "firework",
