{
  "schema_version": 1,
  "id": "chest_open_rays",
  "version": 1,
  "name": "Chest Open Rays",
  "category": "ui",
  "description": "Light rays fan up out of a chest or box over a glow while sparkles rise: rewards, gift boxes.",
  "tags": [
    "chest",
    "open",
    "reward",
    "gift",
    "loot box",
    "rays",
    "unlock",
    "ui"
  ],
  "generator": "fan_burst",
  "generator_version": 1,
  "source_duration_seconds": 1.6,
  "supports_loop": false,
  "required_features": [
    "bones",
    "regions",
    "slot_color",
    "attachment_keys",
    "bezier_curves"
  ],
  "preview": null,
  "images": {
    "ray": "images/ray.png",
    "sparkle": "images/sparkle.png",
    "glow": "images/glow.png"
  },
  "common_overrides": {
    "duration": {
      "default": 1.6,
      "min": 0.1,
      "max": 5.0
    },
    "primary_color": {
      "default": "fff1a8ff"
    },
    "secondary_color": {
      "default": "ffc54aff"
    }
  },
  "parameters": {
    "ray_count": {
      "type": "integer",
      "default": 9,
      "min": 2,
      "max": 24,
      "label": "Rays"
    },
    "spread": {
      "type": "number",
      "default": 110,
      "min": 10,
      "max": 180,
      "label": "Spread",
      "unit": "\u00b0"
    },
    "ray_length": {
      "type": "number",
      "default": 320,
      "min": 50,
      "max": 1000,
      "label": "Ray length",
      "unit": "px"
    },
    "ray_width": {
      "type": "number",
      "default": 90,
      "min": 10,
      "max": 400,
      "label": "Ray width",
      "unit": "px"
    },
    "glow_size": {
      "type": "number",
      "default": 240,
      "min": 0,
      "max": 800,
      "label": "Glow size",
      "unit": "px"
    },
    "sparkles": {
      "type": "integer",
      "default": 12,
      "min": 0,
      "max": 40,
      "label": "Sparkles"
    },
    "hold": {
      "type": "number",
      "default": 0.75,
      "min": 0.3,
      "max": 0.95,
      "label": "Fade start",
      "group": "advanced"
    }
  }
}
