{
  "schema_version": 1,
  "id": "focus_lines",
  "version": 1,
  "name": "Focus Lines",
  "category": "ui",
  "description": "Manga-style speed lines rush in from the edges toward the centre: big moments, combos, boss intros.",
  "tags": [
    "focus",
    "speed lines",
    "manga",
    "anime",
    "impact",
    "combo",
    "intro",
    "ui"
  ],
  "generator": "focus_lines",
  "generator_version": 1,
  "source_duration_seconds": 0.6,
  "supports_loop": false,
  "required_features": [
    "bones",
    "regions",
    "slot_color",
    "attachment_keys",
    "bezier_curves"
  ],
  "preview": null,
  "images": {
    "line": "images/line.png"
  },
  "common_overrides": {
    "duration": {
      "default": 0.6,
      "min": 0.1,
      "max": 5.0
    },
    "primary_color": {
      "default": "ffffffff"
    },
    "secondary_color": {
      "default": "ffe27aff"
    }
  },
  "parameters": {
    "lines": {
      "type": "integer",
      "default": 28,
      "min": 6,
      "max": 80,
      "label": "Lines"
    },
    "outer_radius": {
      "type": "number",
      "default": 420,
      "min": 100,
      "max": 1500,
      "label": "Outer radius",
      "unit": "px"
    },
    "inner_radius": {
      "type": "number",
      "default": 140,
      "min": 0,
      "max": 800,
      "label": "Clear centre",
      "unit": "px",
      "description": "Lines stop before this radius"
    },
    "thickness": {
      "type": "number",
      "default": 8,
      "min": 2,
      "max": 40,
      "label": "Thickness",
      "unit": "px"
    }
  }
}
