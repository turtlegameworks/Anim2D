{
  "schema_version": 1,
  "id": "notification_ping",
  "version": 1,
  "name": "Notification Ping",
  "category": "ui",
  "description": "A badge dot bounces in and rings ripple out from it: new items, messages, unread markers.",
  "tags": [
    "notification",
    "badge",
    "ping",
    "new",
    "alert",
    "ui",
    "button"
  ],
  "generator": "badge_ping",
  "generator_version": 1,
  "source_duration_seconds": 1.0,
  "supports_loop": false,
  "required_features": [
    "bones",
    "regions",
    "slot_color",
    "attachment_keys",
    "bezier_curves"
  ],
  "preview": null,
  "images": {
    "dot": "images/dot.png",
    "ring": "images/ring.png"
  },
  "common_overrides": {
    "duration": {
      "default": 1.0,
      "min": 0.1,
      "max": 5.0
    },
    "primary_color": {
      "default": "ff3b3bff"
    },
    "secondary_color": {
      "default": "ff8f8fff"
    }
  },
  "parameters": {
    "badge_size": {
      "type": "number",
      "default": 36,
      "min": 8,
      "max": 200,
      "label": "Badge size",
      "unit": "px"
    },
    "rings": {
      "type": "integer",
      "default": 2,
      "min": 0,
      "max": 4,
      "label": "Ripples"
    },
    "ripple_size": {
      "type": "number",
      "default": 2.6,
      "min": 1.2,
      "max": 6.0,
      "label": "Ripple size",
      "unit": "x",
      "description": "Ripple end size, times the badge"
    },
    "hold": {
      "type": "number",
      "default": 0.8,
      "min": 0.3,
      "max": 0.98,
      "label": "Fade start",
      "group": "advanced"
    }
  }
}
