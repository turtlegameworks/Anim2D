{
  "schema_version": 1,
  "id": "tap_ripple",
  "version": 1,
  "name": "Tap Ripple",
  "category": "casual",
  "description": "Quick rings spread from a tap or button press over a small glow: UI feedback.",
  "tags": [
    "tap",
    "click",
    "touch",
    "button",
    "ripple",
    "ui",
    "feedback",
    "casual"
  ],
  "generator": "ring_wave",
  "generator_version": 1,
  "source_duration_seconds": 0.45,
  "supports_loop": false,
  "required_features": [
    "bones",
    "regions",
    "slot_color",
    "attachment_keys",
    "bezier_curves"
  ],
  "preview": null,
  "images": {
    "ring": "images/ring.png",
    "glow": "images/glow.png"
  },
  "common_overrides": {
    "duration": {
      "default": 0.45,
      "min": 0.1,
      "max": 5.0
    },
    "primary_color": {
      "default": "ffffffff"
    },
    "secondary_color": {
      "default": "9fd8ffff"
    }
  },
  "parameters": {
    "rings": {
      "type": "integer",
      "default": 2,
      "min": 1,
      "max": 5,
      "label": "Rings"
    },
    "start_size": {
      "type": "number",
      "default": 10,
      "min": 0,
      "max": 200,
      "label": "Start size",
      "unit": "px"
    },
    "end_size": {
      "type": "number",
      "default": 140,
      "min": 20,
      "max": 600,
      "label": "End size",
      "unit": "px"
    },
    "squash": {
      "type": "number",
      "default": 1.0,
      "min": 0.1,
      "max": 1.0,
      "label": "Squash",
      "description": "1 = round; lower looks flat on the ground"
    },
    "glow_size": {
      "type": "number",
      "default": 80,
      "min": 0,
      "max": 300,
      "label": "Glow size",
      "unit": "px",
      "description": "0 removes the glow"
    },
    "ring_gap": {
      "type": "number",
      "default": 0.2,
      "min": 0.0,
      "max": 0.5,
      "label": "Ring gap",
      "group": "advanced"
    }
  }
}
