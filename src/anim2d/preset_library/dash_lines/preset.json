{
  "schema_version": 1,
  "id": "dash_lines",
  "version": 1,
  "name": "Dash Lines",
  "category": "gameplay",
  "description": "Speed streaks trail behind something moving fast to +X: dashes, sprints, swipes. Mirror for -X.",
  "tags": [
    "dash",
    "speed",
    "trail",
    "sprint",
    "motion",
    "swipe",
    "fast",
    "gameplay"
  ],
  "generator": "dash_lines",
  "generator_version": 1,
  "source_duration_seconds": 0.5,
  "supports_loop": false,
  "required_features": [
    "bones",
    "regions",
    "slot_color",
    "attachment_keys",
    "bezier_curves"
  ],
  "preview": null,
  "images": {
    "line": "images/line.png"
  },
  "common_overrides": {
    "duration": {
      "default": 0.5,
      "min": 0.1,
      "max": 5.0
    },
    "primary_color": {
      "default": "ffffffff"
    },
    "secondary_color": {
      "default": "9fd8ffff"
    }
  },
  "parameters": {
    "lines": {
      "type": "integer",
      "default": 9,
      "min": 2,
      "max": 30,
      "label": "Lines"
    },
    "band_height": {
      "type": "number",
      "default": 120,
      "min": 10,
      "max": 600,
      "label": "Height",
      "unit": "px"
    },
    "line_length": {
      "type": "number",
      "default": 220,
      "min": 30,
      "max": 900,
      "label": "Line length",
      "unit": "px"
    },
    "thickness": {
      "type": "number",
      "default": 10,
      "min": 2,
      "max": 40,
      "label": "Thickness",
      "unit": "px"
    },
    "drift": {
      "type": "number",
      "default": 0.6,
      "min": 0.0,
      "max": 2.0,
      "label": "Drift back",
      "unit": "x",
      "description": "How far streaks slide back, times their length"
    }
  }
}
