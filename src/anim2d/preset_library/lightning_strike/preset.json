{
  "schema_version": 1,
  "id": "lightning_strike",
  "version": 1,
  "name": "Lightning Strike",
  "category": "magic",
  "description": "A bolt flickers down from above and flashes where it hits.",
  "tags": [
    "lightning",
    "thunder",
    "bolt",
    "electric",
    "strike",
    "zap"
  ],
  "generator": "flicker_bolt",
  "generator_version": 1,
  "source_duration_seconds": 0.5,
  "supports_loop": false,
  "required_features": [
    "bones",
    "regions",
    "slot_color",
    "attachment_keys",
    "bezier_curves"
  ],
  "preview": null,
  "images": {
    "bolt": "images/bolt.png",
    "flash": "images/flash.png"
  },
  "common_overrides": {
    "duration": {
      "default": 0.5,
      "min": 0.1,
      "max": 4.0
    },
    "primary_color": {
      "default": "d6f0ffff"
    },
    "secondary_color": {
      "default": "8fc9ffff"
    }
  },
  "parameters": {
    "bolt_height": {
      "type": "number",
      "default": 520,
      "min": 100,
      "max": 1500,
      "label": "Bolt height",
      "unit": "px"
    },
    "bolt_width": {
      "type": "number",
      "default": 90,
      "min": 20,
      "max": 300,
      "label": "Bolt width",
      "unit": "px"
    },
    "flickers": {
      "type": "integer",
      "default": 5,
      "min": 1,
      "max": 12,
      "label": "Flickers"
    },
    "flash_size": {
      "type": "number",
      "default": 240,
      "min": 0,
      "max": 700,
      "label": "Impact size",
      "unit": "px"
    },
    "strike_portion": {
      "type": "number",
      "default": 0.35,
      "min": 0.1,
      "max": 0.8,
      "label": "Flicker time",
      "description": "Fraction of the effect spent flickering",
      "group": "advanced"
    }
  }
}
