      "unit": "px"
    },
    "ray_count": {
      "type": "integer",
      "default": 14,
      "min": 4,
      "max": 32,
      "label": "Rays"
    },
    "sparkles": {
      "type": "integer",
      "default": 14,
      "min": 0,
      "max": 40,
      "label": "Sparkles"
