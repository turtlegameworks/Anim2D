{
  "schema_version": 1,
  "id": "light_reveal",
  "version": 1,
  "name": "Light Burst Reveal",
  "category": "reveal",
  "description": "Rays burst out and turn, a big flash whites out the centre, a ring spreads: hero or bonus reveals.",
  "tags": [
    "reveal",
    "light",
    "burst",
    "rays",
    "hero",
    "character",
    "bonus",
    "slots"
  ],
  "generator": "light_reveal",
