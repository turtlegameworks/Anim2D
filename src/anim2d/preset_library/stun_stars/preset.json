{
  "schema_version": 1,
  "id": "stun_stars",
  "version": 1,
  "name": "Stun Stars",
  "category": "gameplay",
  "description": "Stars circle above a head on a flat ring, bigger at the front: stunned, dizzy, knocked out.",
  "tags": [
    "stun",
    "dizzy",
    "stars",
    "knocked out",
    "daze",
    "status",
    "gameplay"
  ],
  "generator": "orbit_stars",
  "generator_version": 1,
  "source_duration_seconds": 1.5,
  "supports_loop": false,
  "required_features": [
    "bones",
    "regions",
    "slot_color",
    "attachment_keys",
    "bezier_curves"
  ],
  "preview": null,
  "images": {
    "star": "images/star.png"
  },
  "common_overrides": {
    "duration": {
      "default": 1.5,
      "min": 0.1,
      "max": 5.0
    },
    "primary_color": {
      "default": "ffd23aff"
    },
    "secondary_color": {
      "default": "fff6c8ff"
    }
  },
  "parameters": {
    "stars": {
      "type": "integer",
      "default": 4,
      "min": 1,
      "max": 10,
      "label": "Stars"
    },
    "width": {
      "type": "number",
      "default": 140,
      "min": 20,
      "max": 600,
      "label": "Ring width",
      "unit": "px"
    },
    "tilt": {
      "type": "number",
      "default": 0.3,
      "min": 0.05,
      "max": 1.0,
      "label": "Tilt",
      "description": "Ring height as a fraction of its width"
    },
    "star_size": {
      "type": "number",
      "default": 30,
      "min": 6,
      "max": 120,
      "label": "Star size",
      "unit": "px"
    },
    "turns": {
      "type": "number",
      "default": 1.5,
      "min": -5.0,
      "max": 5.0,
      "label": "Turns",
      "description": "Negative turns the other way"
    }
  }
}
